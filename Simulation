# ========================================================================
# 1. Core physics: critical angle formulas
# ========================================================================

def critical_angle_core_clad(n1, n2):
    """Critical angle (degrees) at the core-cladding interface, from the
    interface normal. None if n2 > n1 (no TIR possible)."""
    if n2 > n1:
        return None
    return np.degrees(np.arcsin(n2 / n1))


def critical_angle_clad_air(n2, n_air=1.0):
    """Critical angle (degrees) at the cladding-air interface, from the
    interface normal."""
    return np.degrees(np.arcsin(n_air / n2))


def critical_angle_clad_disk(n2, n3):
    """Critical angle (degrees) at the cladding-disk interface, from the
    interface normal. None if n3 > n2 (no TIR possible there - see the
    'always transmits' discussion: TIR only ever happens going into a
    LOWER index, never a higher one)."""
    if n3 > n2:
        return None
    return np.degrees(np.arcsin(n3 / n2))


def sweep_critical_angles(n1, n2_min=1.30, n2_max=1.70, n_points=200):
    """How both critical angles vary as cladding index n2 sweeps, for a
    fixed core index n1."""
    n2_values = np.linspace(n2_min, n2_max, n_points)
    core_clad = np.array([
        critical_angle_core_clad(n1, n2) if n2 <= n1 else np.nan
        for n2 in n2_values
    ])
    clad_air = critical_angle_clad_air(n2_values)
    return n2_values, core_clad, clad_air


