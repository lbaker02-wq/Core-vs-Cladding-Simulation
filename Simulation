def ej160_spectrum_at_length(length_m):
    """Measured EJ-160 spectral SHAPE (unit area) at a given fiber length,
    linearly interpolated in position between the nearest two measured
    positions. Lengths outside the measured 0.124-2.799m range are held at
    the nearest measured spectrum (no extrapolation). Returns (wl_nm, shape)."""
    pos = EJ160_CARRIER_POS_M
    shapes = EJ160_CARRIER_INTENSITY / EJ160_CARRIER_INTENSITY.sum(axis=1, keepdims=True)
    L = float(np.clip(length_m, pos[0], pos[-1]))
    j = min(int(np.searchsorted(pos, L, side="right")) - 1, len(pos) - 2)
    t = (L - pos[j]) / (pos[j + 1] - pos[j])
    return EJ160_CARRIER_WL_NM, (1 - t) * shapes[j] + t * shapes[j + 1]


def ej160_measured_at_length(length_m):
    """Measured EJ-160 spectrum at a fiber length on the common scale of your
    uploaded plot (every position divided by the biggest amplitude, the 0.124m
    peak = 1, so longer lengths are shorter curves). Same linear interpolation
    in position as ej160_spectrum_at_length. Used only to overlay the measured
    SHAPE on the explorer's spectrum plots. Returns (wl_nm, curve)."""
    pos = EJ160_CARRIER_POS_M
    L = float(np.clip(length_m, pos[0], pos[-1]))
    j = min(int(np.searchsorted(pos, L, side="right")) - 1, len(pos) - 2)
    t = (L - pos[j]) / (pos[j + 1] - pos[j])
    row = (1 - t) * EJ160_CARRIER_INTENSITY[j] + t * EJ160_CARRIER_INTENSITY[j + 1]
    return EJ160_CARRIER_WL_NM, row / EJ160_CARRIER_INTENSITY[0].max()


